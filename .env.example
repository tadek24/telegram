# Publiczna konfiguracja produkcyjna — nigdy sekrety.
VITE_MATRIX_HOMESERVER_URL=
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=

# Tymczasowe logowanie przez serwer testowy.
VITE_ENABLE_MATRIX_SSO=false

# Test prawdziwych rozmów przez prywatny serwer: numer telefonu + PIN/hasło.
VITE_ENABLE_PHONE_MATRIX_LOGIN=false

# Włącz wyłącznie lokalnie w .env.local.
VITE_ENABLE_DEV_LOGIN=false

# Tymczasowy, wyłącznie lokalny podgląd aplikacji.
VITE_ENABLE_DEMO_MODE=true
